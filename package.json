{
    "name": "@dpuse/dpuse-presenter-samples",
    "version": "1.0.120",
    "private": false,
    "description": "A library that implements the samples presenter in accordance with the Data Positioning presenter interface.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-presenter-samples/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-presenter-samples.git"
    },
    "module": "./dist/dpuse-presenter-samples.es.js",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/src/index.d.ts",
            "import": "./dist/dpuse-presenter-samples.es.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "esbuild": true,
        "workerd": true,
        "unrs-resolver": true,
        "fsevents": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "prebuild": "node scripts/prebuild.ts",
        "build": "node -e \"import('@dpuse/dpuse-development').then(m => m.buildProject())\"",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject('Apache-2.0;BSD-2-Clause;CC0-1.0;ISC;MIT'))\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run build && npm run document && npm run sync && node -e \"import('@dpuse/dpuse-development').then(m => m.triggerGitHubRelease())\"",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\""
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^1.0.245"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^1.0.160",
        "@dpuse/dpuse-tool-d3-visualiser": "^1.0.118",
        "@dpuse/dpuse-tool-micromark-markdown-parser": "^1.0.106",
        "@dpuse/dpuse-tool-phoria2-visualiser": "^1.0.7",
        "@dpuse/eslint-config-dpuse": "^1.0.153",
        "@types/node": "^26.6.6",
        "@types/trusted-types": "^2.0.7",
        "@vitest/coverage-v8": "^5.1.1",
        "eslint": "^10.15.0",
        "front-matter": "^4.0.2",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.1",
        "sonda": "^0.14.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.1.1",
        "wrangler": "^4.164.0"
    }
}
